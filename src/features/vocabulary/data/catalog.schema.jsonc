/**
 * ═══════════════════════════════════════════════════════════════════════════════
 *  AGENT HANDOFF — Vocabulary word-data schema & authoring contract
 * ═══════════════════════════════════════════════════════════════════════════════
 *
 *  ⚠️  THIS FILE IS DOCUMENTATION ONLY. It is NEVER imported by the app and is NOT
 *      the runtime data. The live data is `catalog.json` in this same folder, which
 *      is STRICT JSON (no comments allowed) and is REGENERATED by:
 *
 *          npm run vocab:import -- "<deck>.json"
 *
 *      `normalizeDeck()` (src/features/vocabulary/lib/schema.ts) rebuilds catalog.json
 *      from a source deck, so ANY comment or extra doc-key placed inside catalog.json
 *      would either break JSON.parse or be wiped on the next import. That is why this
 *      handoff lives beside it as `.jsonc` instead of inside it.
 *
 *  ── How the data reaches the screen ────────────────────────────────────────────
 *    deck JSON  ──normalizeDeck()──▶  data/catalog.json          (admin-editable base)
 *    deck JSON  ──normalizeDeck()──▶  data/packs/<name>.json     (read-only 3rd-party packs)
 *      both are merged in memory by lib/catalog-source.ts (mergeCatalogs: de-dupe by
 *      id/headword, base wins) ──▶ api/catalog.server.ts ──/api/public/vocabulary──▶
 *      useVocabularyFeed ──▶ VocabularyStream ──▶ VocabularyCard ──▶ buildStages() ──▶ pages.
 *    Compile a provider pack with: npm run vocab:import -- "<deck>.json" --pack <name>.
 *    A pack file has the SAME shape documented below (its own revision/name/count/…).
 *
 *  ── The card turns ONE word into this ordered page flow (buildStages, lib/stages.ts) ──
 *    1. lead         (from `leadVi`,     label depends on `style`)   — skipped if absent
 *    2. definition   (from `defVi`,      label "Ý nghĩa")
 *    3. letters      (derived: "Gồm {chars} chữ cái, bắt đầu bằng {initial}")
 *    4. usage        (from `usage[0]`,   label "Trong câu")          — skipped if absent
 *    5. anticipation (from `anticipateVi`, label "Bạn đoán gì?")     — skipped if absent
 *    6. reveal       (the `word` itself, label "Đây rồi!")
 *    7. spelling     (letter-by-letter coda of `word`, appended by VocabularyCard)
 *    Every non-reveal page is further split by paginateText() at clause boundaries.
 *
 *  ── Two emphasis systems (do not mix them up) ────────────────────────────────────
 *    • INLINE markers  `/phrase/`  embedded in defVi / leadVi / anticipateVi / usage.en.
 *      parseEmphasisMarkers() strips the slashes and highlights the phrase on that page.
 *      THIS is the current, authoritative format the feed renders.
 *    • `emphasis` array — LEGACY. Still schema-valid and de-duplicated by
 *      normalizeEmphasisPhrases(), but the feed renderer no longer reads it. Prefer inline.
 *
 *  ── Field-origin legend used below ───────────────────────────────────────────────
 *    [AUTHOR]   you write it in the deck
 *    [DERIVED]  normalizeDeck() computes it — never author, it is overwritten
 *    [LEGACY]   tolerated but superseded
 * ═══════════════════════════════════════════════════════════════════════════════
 */
{
  // ─── Top-level Catalog envelope (type `Catalog` in lib/schema.ts) ───────────────
  // [DERIVED] Build stamp written by the importer; changes on every regeneration.
  "revision": "119deb3f20bd2959539f0791",

  // [DERIVED] Human name, taken from the deck's meta.name (default "WordCrawler vocabulary").
  "name": "WordCrawler mock deck v1.1",

  // [DERIVED] Number of entries in `words`. Kept in sync by normalizeDeck(); do not hand-edit.
  "count": 25,

  // [DERIVED] Sorted union of every word's `topics`. Feeds the topic filter UI.
  "topics": ["attention", "character", "communication", "daily", "emotion", "thinking", "time", "work"],

  // [DERIVED] Only the CEFR levels actually present, in A1→C2 order. Feeds the level filter.
  "levels": ["A2", "B1", "B2"],

  "words": [
    {
      // ══════════════════════════ IDENTITY ══════════════════════════
      // [AUTHOR] Stable unique key. Lowercased on import; regex ^[a-zA-Z0-9_-]+$, 1–80 chars.
      // USED AS: the on-device storage namespace for this reader's heart/bookmark reactions and
      // emoji taps (lib/reactions.ts), the deterministic seed for the mocked crowd emoji totals
      // (mockEmojiTotals(id)), the reported-words log key (hasReportedWord), and the base of the
      // per-occurrence id. Two words may never share an id.
      "id": "resilient",

      // ══════════════════════════ THE ANSWER ══════════════════════════
      // [AUTHOR] The English target word — this is the answer the whole card builds toward.
      // Lowercased + NFC-normalized + curly apostrophes folded to straight on import.
      // Regex: letters only, optional internal ' ’ - (^[a-zA-Z]+(?:['’-][a-zA-Z]+)*$), 2–64 chars.
      // USED AS: the reveal page text, the spelling coda (SpellingAnimation spells it letter by
      // letter), the source of the derived `chars`/`initial` clues, and the answer-mask target —
      // mask() rewrites any occurrence of this word inside clue text to "_____" so a clue can
      // never leak the answer. Must be unique across the deck.
      "word": "resilient",

      // ══════════════════════════ VIETNAMESE PROSE CLUES ══════════════════════════
      // [AUTHOR] REQUIRED. The Vietnamese definition.
      // RENDERED TWICE: (a) as the "Ý nghĩa" kinetic clue page (masked + paginated), and
      // (b) again as prose in the reveal details panel via MarkedText (which honours /markers/).
      // REQUIREMENTS:
      //   • 8–11 Vietnamese words (the char cap alone is too loose — Vietnamese words are short).
      //   • Hard cap 400 chars, min 2.
      //   • May carry AT MOST ONE inline /emphasis/ marker.
      //   • Must not contain the English `word` (it would be masked to "_____" anyway).
      "defVi": "Khả năng /bật dậy/ nhanh sau nghịch cảnh.",

      // [AUTHOR] OPTIONAL. Vietnamese lead-in / riddle that opens the card.
      // RENDERED AS: the first clue page; its label is chosen by `style`
      //   (detective→"Bối cảnh", speed→"Sẵn sàng chưa?", confession→"Có quen không?",
      //    minimal→"Một suy nghĩ"). Omit the field entirely to skip this page.
      // REQUIREMENTS:
      //   • 8–11 Vietnamese words; hard cap 240 chars.
      //   • At most one /emphasis/ marker.
      //   • Teases the meaning WITHOUT naming or containing the answer.
      "leadVi": "Ngã xuống rồi tự /đứng dậy/, chẳng cần ai.",

      // [AUTHOR] OPTIONAL. Short playful teaser shown just before the reveal.
      // RENDERED AS: the "Bạn đoán gì?" page (after the usage example).
      // REQUIREMENTS:
      //   • 3–8 Vietnamese words; hard cap 180 chars.
      //   • Unique per word, playful, never a reused placeholder.
      //   • MUST NOT contain the English answer — normalizeDeck() HARD-FAILS the import if
      //     answerPattern(word) matches this field.
      "anticipateVi": "Thử nhắm mắt đoán…",

      // [LEGACY] Optional array of emphasis phrases (≤6). Superseded by inline /markers/ above.
      // normalizeEmphasisPhrases() NFC-normalizes, collapses whitespace and de-duplicates
      // case-insensitively (keeping diacritics). The feed renderer does NOT read this — prefer
      // inline markers. Left here only so older decks keep validating.
      // "emphasis": ["bật dậy"],

      // ══════════════════════════ REVEAL-DETAILS METADATA ══════════════════════════
      // [AUTHOR] OPTIONAL. Part of speech (e.g. "adj", "n", "v"). ≤40 chars.
      // SHOWN in the reveal details pronunciation line, beside `ipa`.
      "pos": "adj",

      // [AUTHOR] OPTIONAL. IPA pronunciation. ≤120 chars.
      // SHOWN in the reveal details `.vocab-pronunciation` line, beside `pos`.
      "ipa": "/rɪˈzɪl.i.ənt/",

      // ══════════════════════════ TAXONOMY / FILTERING ══════════════════════════
      // [DERIVED-from-topic] Legacy single topic slug. Always restated as topics[0] so the two
      // can never disagree. Lowercase slug (^[a-z0-9-]*$), ≤60 chars, default "general".
      "topic": "character",

      // [AUTHOR] OPTIONAL but canonical. Multi-value topic axis (≤6 lowercase slugs). If a deck
      // supplies only `topic`, normalizeDeck() lifts it into this array. Drives the topic filter
      // and the Catalog.topics union.
      "topics": ["character"],

      // [AUTHOR] OPTIONAL. Exam / competition targets this word is prepared for (≤8 lowercase
      // slugs, ≤40 chars each). Used by the difficulty/track grouping (difficulty is a
      // multi-select union of tracks). De-duplicated on import; omitted when empty.
      // "exams": ["ielts", "toeic"],

      // [AUTHOR] OPTIONAL. CEFR level: one of A1 | A2 | B1 | B2 | C1 | C2.
      // Drives the level filter and the Catalog.levels list.
      "level": "B2",

      // [AUTHOR] OPTIONAL. Per-word narrative style hint: detective | speed | confession | minimal.
      // Selects the lead-page label (see `leadVi`) and influences tempo/rhythm. When absent the
      // card's presentation picker (choosePresentation) chooses one deterministically.
      // "style": "detective",

      // ══════════════════════════ DERIVED — NEVER AUTHOR ══════════════════════════
      // [DERIVED] Count of Unicode letters in `word` (resilient → 9). Recomputed on every import.
      // SHOWN in the letter-count clue: "Gồm {chars} chữ cái, …".
      "chars": 9,

      // [DERIVED] First letter of `word`, uppercased (resilient → "R"). Recomputed on every import.
      // SHOWN in "… bắt đầu bằng {initial}" and drawn with the `frame` secondary emphasis so the
      // single letter reads as boxed, distinct from the count's primary mark.
      "initial": "R",

      // ══════════════════════════ EXAMPLE SENTENCES ══════════════════════════
      // [AUTHOR] OPTIONAL array (≤5) of example sentences.
      // • usage[0] becomes the "Trong câu" clue page: `en` is the primary (English) line,
      //   `vi` is the secondary (Vietnamese) gloss underneath.
      // • The FULL list is also rendered in the reveal details via FilledUsage, which fills the
      //   blank with the answer word.
      // REQUIREMENTS for `en`:
      //   • 1–400 chars. MUST contain a blank of 2+ underscores ("_____") where the answer goes;
      //     completeUsage() replaces /_{2,}/ with the word, and mask() also blanks any literal
      //     occurrence of the answer so the clue page never shows it.
      //   • May carry at most one inline /emphasis/ marker.
      // REQUIREMENTS for `vi`:
      //   • OPTIONAL, ≤400 chars. Vietnamese translation of the example; may carry /markers/.
      "usage": [
        {
          "en": "She proved more _____ than anyone expected.",
          "vi": "Cô ấy chứng tỏ mình mạnh mẽ hơn người ta tưởng."
        }
      ]
    }

    // ── Minimal valid entry ────────────────────────────────────────────────────────
    // Only `id`, `word` and `defVi` are strictly required; everything else is optional or
    // derived. The card simply skips the pages whose source field is absent.
    // {
    //   "id": "example",
    //   "word": "example",
    //   "defVi": "Một /trường hợp/ cụ thể minh hoạ cho điều gì đó."
    // }
  ]
}

/**
 * ═══════════════════════════════════════════════════════════════════════════════
 *  QUICK VALIDATION CHECKLIST (enforced by normalizeDeck / lib/schema.ts)
 * ═══════════════════════════════════════════════════════════════════════════════
 *  □ `id`   unique, ^[a-zA-Z0-9_-]+$, 1–80      □ `word` unique, letters/'/-, 2–64
 *  □ `defVi` present, 2–400 chars, 8–11 words   □ `leadVi` ≤240, 8–11 words (optional)
 *  □ `anticipateVi` ≤180, 3–8 words, NO English answer (hard-fails import)
 *  □ `usage[].en` contains a "_____" blank, ≤400;  `usage[].vi` ≤400
 *  □ inline /emphasis/ markers: ≤1 per field, whole Vietnamese unit (2–3 syllables),
 *    never starting/ending mid-compound, ≤6 words, ≤80 chars, present verbatim in that field
 *  □ `topics`/`exams` lowercase slugs;  `level` ∈ A1..C2;  `style` ∈ the 4 ids
 *  □ DO NOT hand-set `chars`, `initial`, `count`, `revision`, `topics`(top), `levels` — derived
 *
 *  After editing a deck: `npm run vocab:import -- "<deck>.json"`, then RESTART the dev server
 *  (catalog.json is a static import, so the in-memory copy only refreshes on restart).
 * ═══════════════════════════════════════════════════════════════════════════════
 */
