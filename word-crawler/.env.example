# Copy to `.env` (never commit the real file). `npm run crawl` loads it automatically
# through Node's --env-file-if-exists flag.
#
# Set the key of ONE provider. Required for live crawls. Not needed for `npm test`
# or `--dry-run`: every test uses a mocked fetch, so no live paid API call is ever
# required. Never put a real key in this file or in any commit.
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# Which provider to use when `--provider` is omitted (anthropic | together |
# openrouter | openai). `--provider` on the command line wins.
LLM_PROVIDER=together

# Model overrides. Each provider falls back to its own preset default when the
# variable is empty:
#   anthropic  -> claude-haiku-4-5-20251001
#   together   -> meta-llama/Llama-3.3-70B-Instruct-Turbo
#   openrouter -> meta-llama/llama-3.3-70b-instruct
LLM_MODEL=
ANTHROPIC_MODEL=
TOGETHER_MODEL=
OPENROUTER_MODEL=

# Only for `--provider openai` (a custom OpenAI-compatible endpoint, e.g. a local
# server). Required there, and a model must be set too
# (OPENAI_API_KEY / OPENAI_MODEL, or LLM_API_KEY / LLM_MODEL as fallbacks).
# LLM_BASE_URL=http://127.0.0.1:8080/v1
