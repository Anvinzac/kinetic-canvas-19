# Copy to `.env` (never commit the real file). `npm run crawl` loads it automatically
# through Node's --env-file-if-exists flag.
#
# Required for live crawls. Not needed for `npm test` or `--dry-run`:
# every test uses a mocked fetch, so no live paid API call is ever required.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Defaults to claude-haiku-4-5-20251001 (same default as content-hub).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
