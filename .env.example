# KineMedia / kinetic-canvas — root app environment
# Full auto-posting guide: docs/lovable-auto-posting-credentials.md

# ── Supabase (Lovable Cloud → Connect Supabase) ─────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Browser mirrors (Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only — never expose as VITE_*
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional: HTTP ingest from content-hub (SINK=http) ───────────────────────
# AGENT_INGEST_API_KEY=

# ── Admin demo ───────────────────────────────────────────────────────────────
VITE_DEMO_ADMIN=1
# ADMIN_USER_IDS=uuid1,uuid2
