# ── Sink: where produced items are delivered ────────────────────────────────
# "supabase" (default) — password-login as system bot, then enqueue RPC.
# "http" — POST to the app ingest endpoint (app owns validation + service role).
SINK=supabase

# Required when SINK=supabase (see docs/lovable-auto-posting-credentials.md)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Same string as the app's SUPABASE_PUBLISHABLE_KEY / anon key (different env name).
SUPABASE_ANON_KEY=
# Auth user with profiles.is_system = true
SYSTEM_BOT_EMAIL=
SYSTEM_BOT_PASSWORD=

# Required when SINK=http (must match Lovable AGENT_INGEST_API_KEY)
INGEST_URL=https://your-app.example.com
AGENT_INGEST_API_KEY=

# ── Vocabulary source ───────────────────────────────────────────────────────
# "curated" (default, no API key) or "claude" (needs ANTHROPIC_API_KEY).
VOCAB_GENERATOR=curated
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Producer cadence (UTC cron) and batch size. Consumer drains 3×/day via pg_cron.
VOCAB_CRON=0 22 * * *
VOCAB_BATCH=5
