# ── Sink: where produced items are delivered ────────────────────────────────
# "supabase" (default) calls the enqueue_agent_content_item RPC directly.
# "http" POSTs to the app's ingestion endpoint instead (app owns validation).
SINK=supabase

# Required when SINK=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Required when SINK=http
INGEST_URL=https://your-app.example.com/api/agent-content
AGENT_INGEST_API_KEY=

# ── Vocabulary source ───────────────────────────────────────────────────────
# "curated" (default, no key) or "claude" (always-on generated feed).
VOCAB_GENERATOR=curated
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Producer cadence (UTC cron) and batch size. The consumer drains 3×/day.
VOCAB_CRON=0 22 * * *
VOCAB_BATCH=5
