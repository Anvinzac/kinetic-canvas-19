{
  "name": "content-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent content-feeder service. Produces normalized content items (vocabulary, news, recipes, jobs, ...) and delivers them into the app's agent-content queue.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "run": "tsx src/cli.ts run",
    "serve": "tsx src/cli.ts serve",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "node-cron": "^3.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
